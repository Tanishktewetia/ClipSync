<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ClipSync Design System — Light Theme
         Palette: neutral surfaces with a restrained blue action color.
         Font: Segoe UI Variable (Win11 system font), fallback Segoe UI.
         Spacing: 8px grid. Corners: 12px cards, 8px buttons. -->

    <!-- Primary -->
    <Color x:Key="PrimaryColor">#245C96</Color>
    <Color x:Key="PrimaryHoverColor">#173C63</Color>
    <Color x:Key="PrimaryLightColor">#E7EFF8</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#326751</Color>
    <Color x:Key="AccentLightColor">#E7F1EB</Color>

    <!-- Status colors -->
    <Color x:Key="ConnectedColor">#10B981</Color>
    <Color x:Key="WaitingColor">#F59E0B</Color>
    <Color x:Key="PausedColor">#245C96</Color>
    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="DisconnectedColor">#6B7280</Color>

    <!-- Neutrals -->
    <Color x:Key="BackgroundColor">#F7F8FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#D7DCE3</Color>
    <Color x:Key="TextPrimaryColor">#20242B</Color>
    <Color x:Key="TextSecondaryColor">#505965</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />

    <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource ConnectedColor}" />
    <SolidColorBrush x:Key="WaitingBrush" Color="{StaticResource WaitingColor}" />
    <SolidColorBrush x:Key="PausedBrush" Color="{StaticResource PausedColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="{StaticResource DisconnectedColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <!-- Typography -->
    <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

    <!-- Spacing -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,12</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

</ResourceDictionary>
