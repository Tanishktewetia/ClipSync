<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ClipSync Design System — Dark Theme
         Same palette structure as LightTheme, with inverted neutrals. -->

    <!-- Primary (slightly brighter for dark backgrounds) -->
    <Color x:Key="PrimaryColor">#9CC7FF</Color>
    <Color x:Key="PrimaryHoverColor">#BEDBFF</Color>
    <Color x:Key="PrimaryLightColor">#263B52</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#A0D3B5</Color>
    <Color x:Key="AccentLightColor">#253C30</Color>

    <!-- Status colors (slightly adjusted for dark backgrounds) -->
    <Color x:Key="ConnectedColor">#34D399</Color>
    <Color x:Key="WaitingColor">#FBBF24</Color>
    <Color x:Key="PausedColor">#9CC7FF</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="DisconnectedColor">#9CA3AF</Color>

    <!-- Neutrals (inverted) -->
    <Color x:Key="BackgroundColor">#181A1D</Color>
    <Color x:Key="SurfaceColor">#23262B</Color>
    <Color x:Key="CardColor">#23262B</Color>
    <Color x:Key="BorderColor">#444B55</Color>
    <Color x:Key="TextPrimaryColor">#F5F6F8</Color>
    <Color x:Key="TextSecondaryColor">#C1C7D0</Color>
    <Color x:Key="TextOnPrimaryColor">#102A45</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />

    <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource ConnectedColor}" />
    <SolidColorBrush x:Key="WaitingBrush" Color="{StaticResource WaitingColor}" />
    <SolidColorBrush x:Key="PausedBrush" Color="{StaticResource PausedColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="{StaticResource DisconnectedColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <!-- Typography (same as light) -->
    <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>

    <!-- Spacing (same as light) -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,12</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

</ResourceDictionary>
