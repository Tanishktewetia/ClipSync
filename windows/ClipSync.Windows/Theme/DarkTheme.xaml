<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ClipSync Design System — Dark Theme
         Same palette structure as LightTheme, with inverted neutrals. -->

    <!-- Primary (slightly brighter for dark backgrounds) -->
    <Color x:Key="PrimaryColor">#818CF8</Color>
    <Color x:Key="PrimaryHoverColor">#A5B4FC</Color>
    <Color x:Key="PrimaryLightColor">#1E1B4B</Color>

    <!-- Accent -->
    <Color x:Key="AccentColor">#2DD4BF</Color>
    <Color x:Key="AccentLightColor">#134E4A</Color>

    <!-- Status colors (slightly adjusted for dark backgrounds) -->
    <Color x:Key="ConnectedColor">#34D399</Color>
    <Color x:Key="WaitingColor">#FBBF24</Color>
    <Color x:Key="PausedColor">#A78BFA</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="DisconnectedColor">#9CA3AF</Color>

    <!-- Neutrals (inverted) -->
    <Color x:Key="BackgroundColor">#111827</Color>
    <Color x:Key="SurfaceColor">#1F2937</Color>
    <Color x:Key="CardColor">#1F2937</Color>
    <Color x:Key="BorderColor">#374151</Color>
    <Color x:Key="TextPrimaryColor">#F9FAFB</Color>
    <Color x:Key="TextSecondaryColor">#9CA3AF</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />

    <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource ConnectedColor}" />
    <SolidColorBrush x:Key="WaitingBrush" Color="{StaticResource WaitingColor}" />
    <SolidColorBrush x:Key="PausedBrush" Color="{StaticResource PausedColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="{StaticResource DisconnectedColor}" />

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />

    <!-- Typography (same as light) -->
    <FontFamily x:Key="AppFont">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>
    <sys:Double x:Key="FontSizeTitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle" xmlns:sys="clr-namespace:System;assembly=mscorlib">13</sys:Double>
    <sys:Double x:Key="FontSizeBody" xmlns:sys="clr-namespace:System;assembly=mscorlib">12</sys:Double>
    <sys:Double x:Key="FontSizeCaption" xmlns:sys="clr-namespace:System;assembly=mscorlib">10</sys:Double>

    <!-- Spacing (same as light) -->
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="SectionSpacing">0,0,0,12</Thickness>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>

</ResourceDictionary>
