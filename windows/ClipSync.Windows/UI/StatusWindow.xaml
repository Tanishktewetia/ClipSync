<Window x:Class="ClipSync.Windows.UI.StatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipSync" Width="400" SizeToContent="Height" WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Deactivated="Window_Deactivated">
    <Border CornerRadius="18" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" Margin="8" Effect="{StaticResource PopoverShadow}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22">
                <DockPanel Margin="0,0,0,18" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Click="Hide_Click" Width="32" Height="32"
                            ToolTip="Hide panel — keep syncing" AutomationProperties.Name="Hide panel, keep syncing"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="0" />
                    <StackPanel>
                        <TextBlock Text="ClipSync" FontFamily="{DynamicResource AppFont}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="BuildLabel" Text="Text only" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
                <Border x:Name="StatusCard" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="18" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusIcon" Text="◌" FontSize="27" Foreground="{DynamicResource WaitingBrush}" VerticalAlignment="Top" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="StatusText" Text="Waiting" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="StatusDetail" Text="Pair your phone to start syncing." TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Secure pairing" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="PairCodeText" Text="Open a pairing window when ready" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Compare the code on your phone within two minutes." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="Pair new device" Click="Pair_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8"/>
                <Button x:Name="PauseButton" Content="Pause syncing" Click="Pause_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8"/>
                <Button Content="Open log folder" Click="OpenLogFolder_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,8"/>
                <TextBlock Text="Hide this panel to keep sharing in the background." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,8,4,6"/>
                <Button Content="Quit ClipSync (stop sharing)" Click="Exit_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
