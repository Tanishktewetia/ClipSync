<Window x:Class="ClipSync.Windows.UI.StatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ClipSync" Width="360" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" Deactivated="Window_Deactivated">
<Border CornerRadius="18" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="8" Effect="{StaticResource PopoverShadow}"><StackPanel Margin="20">
<DockPanel Margin="0,0,0,16" LastChildFill="False"><TextBlock Text="ClipSync" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="BuildLabel" Text="Text only" Margin="12,0,0,0" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/></DockPanel>
<Border x:Name="StatusCard" CornerRadius="14" Background="{DynamicResource SurfaceBrush}" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusIcon" Text="◌" FontSize="27" Foreground="{DynamicResource WaitingBrush}" VerticalAlignment="Top" Margin="0,0,12,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="StatusText" Text="Waiting" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="StatusDetail" Text="Pair a device to start syncing." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel></Grid></Border>
<Border Background="{DynamicResource PrimaryLightBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock Text="PAIR NEW DEVICE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/><TextBlock x:Name="PairCodeText" Text="Open a pairing window when ready" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/><TextBlock Text="The code expires after two minutes." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></Border>
<Button Content="Pair new device" Click="Pair_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,6"/><Button x:Name="PauseButton" Content="Pause syncing" Click="Pause_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,6"/><Button Content="Open log folder" Click="OpenLogFolder_Click" Style="{StaticResource ActionButtonStyle}" Margin="0,0,0,6"/><Button Content="Exit ClipSync" Click="Exit_Click" Style="{StaticResource SecondaryButtonStyle}"/>
</StackPanel></Border></Window>
